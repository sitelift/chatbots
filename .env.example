# SiteLift Chatbots configuration
# You don't need to edit this by hand - just run ./install.sh
# It will create .env with ENCRYPTION_KEY + ADMIN_TOKEN for you.
# Never commit .env.

# Bind address. Use 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1

# Port the server listens on.
PORT=3000

# SQLite database file path.
DATABASE_PATH=data/sitelift.db

# 32-byte AES-256-GCM key, base64-encoded. Auto-generated by ./install.sh
# (or auto-generated on first `docker compose up` and stored in the volume).
ENCRYPTION_KEY=

# Admin auth: email+password + passkey (WebAuthn) via cookie sessions.
# Create the first owner at /admin/login?setup=1 or POST /api/auth/setup.
# No env needed for users; sessions are stored in SQLite.
# SESSION_TTL_MS=2592000000  # 30 days

# Legacy bearer token (deprecated). Only used when no users exist and ALLOW_ADMIN_TOKEN_FALLBACK=1.
# New installs should leave this empty.
ADMIN_TOKEN=

# Global AI provider key (OpenAI-compatible). You can set it here OR in Admin > Settings.
# Works with OpenAI or OpenRouter (https://openrouter.ai/keys). OPENROUTER_API_KEY is an alias.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional base URL for the AI provider. Defaults to https://api.openai.com/v1.
# For OpenRouter use: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENROUTER_BASE_URL=

# Optional attribution headers for OpenRouter (https://openrouter.ai/docs/app-attribution).
# Stored in Admin > Settings as siteUrl / appTitle. Env fallback only.
SITE_URL=
APP_TITLE=
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=
