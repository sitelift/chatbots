# SiteLift Chatbots configuration
# Copy to .env and fill in values. Never commit .env.

# Bind address. Use 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1

# Port the server listens on.
PORT=3000

# SQLite database file path.
DATABASE_PATH=data/sitelift.db

# 32-byte AES-256-GCM key, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional bearer token guarding admin routes and the dashboard.
# Leave empty to disable admin auth (single trusted admin).
ADMIN_TOKEN=

# Global AI provider key (OpenAI-compatible). Used for all chatbots when no
# key is set in Admin > Settings. You can also set the key entirely from the
# admin dashboard instead.
OPENAI_API_KEY=

# Optional base URL for the AI provider. Defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=
