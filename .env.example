# SiteLift configuration
# Copy to .env and fill in what you need. Never commit .env.

# Bind address. Use 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1

# Port the server listens on.
PORT=3000

# SQLite database file path.
DATABASE_PATH=data/sitelift.db

# 32-byte secret used to encrypt the AI API key at rest (AES-256-GCM).
# Required before storing a key in Admin → Settings.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# Global AI provider key (OpenAI-compatible). Set it here OR in Admin → Settings.
# Works with OpenAI, OpenRouter, Groq, Ollama, or any compatible endpoint.
OPENAI_API_KEY=

# Optional base URL. Defaults to https://api.openai.com/v1.
# Examples: https://openrouter.ai/api/v1 · http://localhost:11434/v1 (Ollama)
OPENAI_BASE_URL=

# Default chat model when a chatbot does not override it.
AI_MODEL=gpt-4o-mini
